# ── Supabase (public, exposé au navigateur) ─────────────────────────────
# Projet Supabase partagé « digickos » — les tables SPOT vivent dans le
# schéma Postgres dédié « spot ».
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ── Supabase (secret, serveur uniquement — jamais NEXT_PUBLIC_) ─────────
# REQUIS en Phase 1 : la RLS interdit au client d'écrire dans orders,
# order_items et tickets. Ces écritures passent par le rôle service_role.
# À copier depuis Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Paiement Mobile Money ───────────────────────────────────────────────
# « mock »  : provider de développement, aucun compte requis. Le tunnel
#             complet (commande → webhook signé → émission des billets)
#             est testable localement.
# « campay » : agrégateur MTN MoMo + Orange Money (collection + disbursement).
PAYMENT_PROVIDER=mock

# Secret de signature des webhooks du provider « mock » uniquement : il
# sert à signer les rappels locaux. Mets n'importe quelle chaîne aléatoire
# longue. Campay n'utilise PAS cette clé — voir CAMPAY_WEBHOOK_KEY.
PAYMENT_WEBHOOK_SECRET=

# ── Campay (quand PAYMENT_PROVIDER=campay) ──────────────────────────────
# CAMPAY_APP_USERNAME=
# CAMPAY_APP_PASSWORD=
# CAMPAY_ENV=sandbox
#
# Clé de webhook de l'application, distincte des identifiants d'API : elle
# valide le JWT que Campay place dans le champ « signature » du corps.
# Sans elle, tout webhook Campay est refusé.
# CAMPAY_WEBHOOK_KEY=
