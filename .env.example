# ── Supabase (public, exposé au navigateur) ─────────────────────────────
# Projet Supabase partagé « digickos » — les tables SPOT vivent dans le
# schéma Postgres dédié « spot ».
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ── Supabase (secret, serveur uniquement — jamais NEXT_PUBLIC_) ─────────
# Nécessaire à partir de la Phase 1 (émission de billets côté serveur).
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Campay — agrégateur Mobile Money MTN & Orange (Phase 1) ─────────────
# Collection (encaissement billets) + Disbursement (commissions/reversements)
# CAMPAY_APP_USERNAME=
# CAMPAY_APP_PASSWORD=
# CAMPAY_WEBHOOK_SECRET=
# CAMPAY_ENV=sandbox
